# Talk Me Out of It — Environment Variables
#
# Copy this file to .env.local and fill in your YouCam API credentials.
# Get your API key from https://yce.perfectcorp.com/api-console
# (Hackathon participants get 1,000 free units via the redeem code
#  emailed after registering at https://youcam-api.devpost.com)
#
# If YOUCAM_API_KEY is not set, /api/tryon automatically uses DEMO MODE
# (a pre-generated real YouCam result image, clearly labeled
# "DEMO MODE — PRE-GENERATED RESULT"). The user's uploaded photos are
# NOT sent to YouCam in demo mode. The rest of the flow runs identically
# either way.

# Your YouCam API key (required for real Apparel VTO calls)
YOUCAM_API_KEY=

# YouCam API base URL (optional, defaults to the documented endpoint)
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# --- DoraHacks launch: quota fuse + funnel events (all optional) ---
#
# Upstash Redis (REST). Powers BOTH the global YouCam budget fuse and the
# anonymous funnel counters (/api/event). Without these, the budget fuse
# degrades to per-serverless-instance counting and events fall back to
# deployment logs — the app still runs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Global hard cap on successful YouCam generations (1,000 credits at
# 2 credits per generation = 500). Only successful generations count;
# failures and timeouts are refunded.
TMOI_MAX_GENERATIONS=500
