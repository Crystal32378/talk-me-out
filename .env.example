# Talk Me Out of It — Environment Variables
#
# Copy this file to .env.local and fill in your YouCam API credentials.
# Get your API key from https://yce.perfectcorp.com/api-console
# (Hackathon participants get 1,000 free units via the redeem code
#  emailed after registering at https://youcam-api.devpost.com)
#
# If YOUCAM_API_KEY is not set, /api/tryon automatically uses DEMO MODE
# (a sharp-composited overlay clearly labeled "DEMO MODE — PRE-GENERATED
# RESULT"). The rest of the flow runs identically either way.

# Your YouCam API key (required for real Apparel VTO calls)
YOUCAM_API_KEY=

# YouCam API base URL (optional, defaults to the documented endpoint)
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
